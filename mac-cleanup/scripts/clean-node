#!/usr/bin/env python3
"""List or delete regenerable JS folders. Requires Python 3.9 or newer."""

import argparse
from functools import lru_cache
import json
import os
from pathlib import Path
import shutil
import shlex
import subprocess
import sys
import time


TARGETS = {"node_modules", ".next", ".turbo", ".nuxt", ".svelte-kit", ".parcel-cache"}


def nonnegative_integer(value):
    if not value.isdecimal():
        raise argparse.ArgumentTypeError("must be a nonnegative integer")
    return int(value)


@lru_cache(maxsize=1)
def protected_roots():
    home = Path.home().resolve()
    paths = [
        home / name for name in (
            "Library", ".bun", ".npm", ".nvm", ".volta", ".asdf",
            ".local/share/mise", ".local/share/pnpm", ".local/share/nvim",
            ".config/nvim", ".vscode", ".vscode-insiders", ".cursor",
        )
    ]
    paths.extend(Path(name) for name in ("/Applications", "/Library", "/System", "/usr", "/opt/homebrew"))
    return [path.resolve() for path in paths]


def is_protected(path):
    return any(path == parent or parent in path.parents for parent in protected_roots())


def validate_root(value):
    root = Path(value).expanduser().resolve(strict=True)
    home = Path.home().resolve()
    if root == home or root in home.parents or is_protected(root):
        raise ValueError(f"Refusing protected scan root: {root}")
    if not root.is_dir():
        raise ValueError(f"Not a directory: {root}")
    return root


def walk_error(error):
    raise error


def contains_repository(path):
    for _, directories, files in os.walk(path, onerror=walk_error, followlinks=False):
        if ".git" in directories or ".git" in files:
            return True
    return False


def has_tracked_files(path):
    # A .git file also identifies a worktree or submodule. Once a repository
    # is found, any Git failure must abort rather than mean "untracked".
    if not any(os.path.lexists(parent / ".git") for parent in path.parents):
        return False
    result = subprocess.run(
        ["git", "--literal-pathspecs", "-C", str(path.parent), "ls-files", "-z", "--", path.name],
        check=True, stdout=subprocess.PIPE,
    )
    return bool(result.stdout)


def eligible(path):
    if contains_repository(path) or has_tracked_files(path):
        print(f"Skipped Git content: {json.dumps(str(path))}", file=sys.stderr)
        return False
    return True


def scan(root, days, exclusions):
    found = []
    cutoff = None if days is None else time.time() - days * 86400
    for current, directories, _ in os.walk(root, onerror=walk_error, followlinks=False):
        for name in sorted(directories[:]):
            path = Path(current) / name
            if (name == ".git" or path.is_symlink() or is_protected(path)
                    or any(path == excluded or excluded in path.parents for excluded in exclusions)):
                directories.remove(name)
            elif name in TARGETS:
                directories.remove(name)
                if cutoff is not None and path.stat().st_mtime >= cutoff:
                    continue
                if eligible(path):
                    found.append(path)
    return found


def disk_usage_kib(path):
    output = subprocess.check_output(["du", "-sk", str(path)])
    return int(output.split(b"\t", 1)[0])


def show_candidates(paths):
    sizes = [(disk_usage_kib(path), path) for path in paths]
    for size, path in sorted(sizes, reverse=True):
        print(f"{size:>10,} KiB  {json.dumps(str(path), ensure_ascii=False)}")
    print(f"{sum(size for size, _ in sizes):>10,} KiB  total ({len(paths)} folders; not predicted freed space)")


def fingerprint(path):
    metadata = path.stat()
    return [metadata.st_dev, metadata.st_ino, metadata.st_mtime_ns]


def current_store(root):
    output = subprocess.check_output(["pnpm", "store", "path"], cwd=root, text=True).rstrip("\r\n")
    path = Path(output)
    if not path.is_absolute() or not path.is_dir():
        raise ValueError(f"pnpm did not return an existing absolute store directory: {output!r}")
    return str(path.resolve(strict=True))


def show_store(store):
    if store is not None:
        print(f"Additional action: pnpm store prune\nStore: {json.dumps(store)} ({disk_usage_kib(store):,} KiB)")
        print("Pruning affects the shared store, beyond the listed project folders; size is not predicted freed space.")


def check_store(root, store):
    if store is not None and (not isinstance(store, str) or current_store(root) != store):
        raise ValueError("pnpm store changed since preview; create and review a new plan")


def save_plan(destination, root, paths, store):
    destination = Path(destination).expanduser().resolve()
    if any(path == destination or path in destination.parents for path in paths):
        raise ValueError("Save the plan outside the folders being deleted")
    plan = {
        "version": 1,
        "root": str(root),
        "targets": [{"path": str(path), "fingerprint": fingerprint(path)} for path in paths],
        "prune_store": store,
    }
    with destination.open("x") as output:
        json.dump(plan, output, indent=2)
        output.write("\n")
    print(f"Plan saved: {destination}")
    print(f"After approval: clean-node --delete --from-plan {shlex.quote(str(destination))}")


def check_target(root, entry):
    if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
        raise ValueError("Invalid target in cleanup plan")
    path = Path(entry["path"])
    if (not path.is_absolute() or root not in path.parents or path.name not in TARGETS
            or ".git" in path.relative_to(root).parts or is_protected(path)):
        raise ValueError(f"Invalid cleanup target: {path}")
    if path.resolve(strict=True) != path or not path.is_dir():
        raise ValueError(f"Target is no longer a regular directory at the approved path: {path}")
    if fingerprint(path) != entry.get("fingerprint"):
        raise ValueError(f"Target changed since preview; create and review a new plan: {path}")
    if not eligible(path):
        raise ValueError(f"Target now contains Git content; create and review a new plan: {path}")
    return path


def read_plan(source):
    with Path(source).expanduser().open() as input_file:
        plan = json.load(input_file)
    if (not isinstance(plan, dict) or plan.get("version") != 1
            or not isinstance(plan.get("root"), str) or not isinstance(plan.get("targets"), list)):
        raise ValueError("Invalid cleanup plan format")
    root = validate_root(plan["root"])
    if str(root) != plan["root"]:
        raise ValueError("Plan root changed since preview")
    paths = [check_target(root, entry) for entry in plan["targets"]]
    for index, path in enumerate(paths):
        if any(path == other or path in other.parents or other in path.parents for other in paths[:index]):
            raise ValueError(f"Duplicate or overlapping cleanup target: {path}")
    store = plan.get("prune_store")
    check_store(root, store)
    return root, plan["targets"], paths, store


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--delete", action="store_true", help="delete only targets from --from-plan")
    parser.add_argument("--days", type=nonnegative_integer, help="minimum age of each target folder's own mtime")
    parser.add_argument("--exclude", action="append", default=[], help="skip a directory (relative to scan root or absolute); repeatable")
    parser.add_argument("--plan", help="save the preview to a new JSON file")
    parser.add_argument("--from-plan", help="review or delete an existing plan without rescanning")
    parser.add_argument("--prune-store", action="store_true", help="include shared pnpm store pruning in the preview and plan")
    parser.add_argument("dir", nargs="?", help="scan root (default: ~/Code)")
    args = parser.parse_args()
    if args.delete and not args.from_plan:
        parser.error("--delete requires --from-plan; first save and review a --plan")
    if args.from_plan:
        if args.plan or args.dir or args.days is not None or args.exclude or args.prune_store:
            parser.error("--from-plan cannot be combined with scan options")
        root, entries, found, store = read_plan(args.from_plan)
        show_candidates(found)
        show_store(store)
        if not args.delete:
            print("Dry run of saved plan. No folders deleted.")
            return
        for entry in entries:
            path = check_target(root, entry)
            shutil.rmtree(path)
            print(f"Deleted: {json.dumps(str(path))}", flush=True)
        print(f"Deleted {len(found)} folders.", flush=True)
        if store is not None:
            check_store(root, store)
            print(f"Folder deletion completed. Pruning approved pnpm store: {store}", flush=True)
            result = subprocess.run(["pnpm", "store", "prune"], cwd=root)
            if result.returncode:
                print("Folder deletion completed, but pnpm store pruning failed.", file=sys.stderr)
                return result.returncode
            print("pnpm store pruning completed.")
        return
    root = validate_root(args.dir or Path.home() / "Code")
    exclusions = []
    for value in args.exclude:
        path = (root / Path(value).expanduser()).resolve(strict=True)
        if root != path and root not in path.parents:
            parser.error(f"Excluded directory must be within scan root: {path}")
        if not path.is_dir():
            parser.error(f"Excluded path must be a directory: {path}")
        exclusions.append(path)
    found = [] if root in exclusions else scan(root, args.days, exclusions)
    if not found:
        print(f"Nothing to clean in {root}")
    show_candidates(found)
    store = current_store(root) if args.prune_store else None
    show_store(store)
    if args.plan:
        save_plan(args.plan, root, found, store)
    else:
        print("\nDry run. Use --plan FILE to save exact targets for review and deletion.")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"clean-node: {error}", file=sys.stderr)
        sys.exit(1)
